# Supabase (Project Settings -> API Keys)
# Nama kunci baru (disarankan): publishable = publik, secret = server-only
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Nama kunci JWT lama tetap didukung sebagai fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 32-byte base64 key for AES-256-GCM (AI key encryption at rest)
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# long random string, signs the admin session cookie
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# shared secret for Vercel Cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# public base URL (metadata / share)
NEXT_PUBLIC_APP_URL=http://localhost:3000
